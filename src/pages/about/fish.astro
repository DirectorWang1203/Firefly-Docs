---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import { dynamicConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const fishPost = await getEntry("spec", "fish");

if (!fishPost) {
	throw new Error("Fish about page content not found");
}

const { Content } = await render(fishPost);
const name = dynamicConfig.localPosts?.name || "今天也没被做成鱼罐头";
---

<MainGridLayout
	title={name}
	description="一条蓝鲸鱼，现在住在别人的博客里。"
>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
